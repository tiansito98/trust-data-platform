# Credenciales y secretos
.env
*.env
.env.local
.env.*.local
*.pem
*.ppk
*.key
*_rsa
*_ed25519
*.pub

# Streamlit secrets
.streamlit/secrets.toml

# Claude Code local config (paths + permission allowlist, machine-specific)
.claude/settings.local.json

# Data local (SQLite legacy + cualquier dump)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.duckdb
data/*.duckdb.wal
data/*.csv
data/*.parquet
data/*.dump
data/*.sql.gz

# Logs de pipelines
logs/*.log
logs/*.txt

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Notebooks (pueden contener data/queries reales — solo locales)
*.ipynb
notebooks/

# Auto-generated docs que pueden incluir sample values con PII real (emails,
# nombres, cedulas, telefonos). Solo locales.
docs/data_dictionary.md
docs/*_samples.md
docs/*_samples.yml
docs/*_dump.md

# Dashboard user credentials (hashed but still sensitive).
# users.yml.example (template with dummy hashes) IS committed.
dashboard_v2/config/users.yml

# Excel lock files
~$*.xlsx

# =============================================================================
# Datos de personas identificadas - NO subir: el repo es publico.
# Los archivos siguen existiendo en local; simplemente no se versionan.
# =============================================================================
# docs/private/ is THE folder for anything we don't publish: personal data,
# exports with internal figures, HR material. Everything in it is ignored; only
# the README is tracked, so the folder exists on a fresh clone and nobody
# invents a different convention.
docs/private/*
!docs/private/README.md

# July 2026 commission audit (now under docs/private/). Rule kept in case the
# file is ever dropped loose into docs/ again.
docs/auditoria_comisiones_*.xlsx
scripts/audit/
