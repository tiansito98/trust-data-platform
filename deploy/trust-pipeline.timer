[Unit]
Description=Dispara el pipeline Trust 1x/dia (05:00 UTC = 00:00 COT)

[Timer]
# Las tablas core del datashare Sixt (rentals, charges, channels) cierran a las
# 04:30 UTC (las mas tardias). Corremos a las 05:00 UTC para tomar el dato mas
# fresco posible con el minimo lag. Una sola corrida/dia: esos datos solo se
# refrescan una vez, correr 2x no aporta y gasta budget de IO de Supabase.
#   05:00 UTC = 00:00 COT (medianoche Colombia, fuera de horario laboral).
OnCalendar=*-*-* 05:00:00 UTC
# Si la VM estaba apagada a la hora del disparo, corre al prender.
Persistent=true
# Jitter para no pegarle a Supabase en el segundo exacto.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
